{
  "manifest_version": 3,
  "name": "Synapse Clipper",
  "version": "1.0",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "host_permissions": [
    "https://second-brain-phi-liart.vercel.app/*",
    "https://secondbrain-tfgn.onrender.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://second-brain-phi-liart.vercel.app/*"],
      "js": ["content.js"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Synapse Clipper"
  },
  "description": "Save websites and create media directly to your Synapse brain."
}
